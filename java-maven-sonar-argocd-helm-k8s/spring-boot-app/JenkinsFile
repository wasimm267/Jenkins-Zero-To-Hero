pipeline {
  agent {
    docker {
      image 'maven:3.9.6-eclipse-temurin-17'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  environment {
    SONAR_URL = "http://192.168.106.130:9000"
    DOCKER_IMAGE = "wasimm267/ultimate-cicd:${BUILD_NUMBER}"
    GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
    GIT_USER_NAME = "wasimm267"
  }

  stages {

    stage('Install Docker CLI') {
      steps {
        sh '''
          echo "Installing Docker CLI inside container..."
          apt-get update
          DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io
          docker --version
        '''
      }
    }

    stage('Checkout') {
      steps {
        checkout([$class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[url: 'https://github.com/wasimm267/Jenkins-Zero-To-Hero.git']],
          extensions: [[$class: 'CloneOption', shallow: false]]
        ])
      }
    }

    stage('Build and Test') {
      steps {
        sh '''
          cd java-maven-sonar-argocd-helm-k8s/spring-

